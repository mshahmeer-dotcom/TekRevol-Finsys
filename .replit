modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
BASE_PATH = "/"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && SERVER_PORT=3001 node --import tsx/esm index.ts"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3002

[[ports]]
localPort = 5051
externalPort = 5000

[[ports]]
localPort = 5052
externalPort = 5173

[[ports]]
localPort = 5097
externalPort = 4200

[[ports]]
localPort = 5099
externalPort = 6000

[[ports]]
localPort = 5999
externalPort = 8000

[[ports]]
localPort = 18748
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3003

[deployment]
deploymentTarget = "cloudrun"
run = ["bash", "-c", "cd server && NODE_ENV=production PORT=5000 node --import tsx/esm index.ts"]
build = ["bash", "-c", "pnpm install && BASE_PATH=/ pnpm run build"]
